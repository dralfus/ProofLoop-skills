{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofLoop QWEN_PATCH_CANDIDATE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "successful_recon",
    "files",
    "changed_lines",
    "targeted_tests",
    "git_operations",
    "full_suite"
  ],
  "properties": {
    "successful_recon": {"const": true},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "changed_lines": {"type": "integer", "minimum": 1, "maximum": 200},
    "targeted_tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "git_operations": {"type": "array", "maxItems": 0},
    "full_suite": {"const": false},
    "summary": {"type": "string", "minLength": 1},
    "stop_reason": {"type": ["string", "null"]}
  }
}
