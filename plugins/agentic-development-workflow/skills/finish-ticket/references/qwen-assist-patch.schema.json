{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "successful_recon",
    "files",
    "changed_lines",
    "targeted_tests",
    "git_operations",
    "full_suite"
  ],
  "properties": {
    "successful_recon": {"type": "boolean"},
    "files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "changed_lines": {"type": "integer"},
    "targeted_tests": {
      "type": "array",
      "items": {"type": "string"}
    },
    "git_operations": {"type": "array", "items": {"type": "string"}},
    "full_suite": {"type": "boolean"},
    "summary": {"type": "string"},
    "stop_reason": {"type": "string"}
  }
}
